{
  "schemaVersion": "1.0",
  "type": "boilerplate",
  "name": "02-saas-starter",
  "title": "SaaS Starter - API multi-tenant com assinatura e faturamento",
  "path": "boilerplates/02-saas-starter",
  "readme": "boilerplates/02-saas-starter/README.md",
  "stack": [
    "NestJS 12",
    "TypeORM",
    "Postgres",
    "JWT",
    "Vitest"
  ],
  "useCases": [
    "SaaS B2B",
    "Multi-tenant",
    "Assinatura",
    "Faturamento",
    "Auth com papéis"
  ],
  "commands": [
    "npm install",
    "npm run start:dev",
    "npm test",
    "npm run lint"
  ],
  "gates": [
    "npm test",
    "npm run lint",
    "npm run build"
  ],
  "tokenPolicy": {
    "firstRead": [
      "boilerplate.manifest.json",
      "README.md",
      "memory/30-domains/identity/context.md",
      "memory/30-domains/billing/context.md"
    ],
    "avoidLoadingByDefault": [
      "node_modules",
      "dist",
      "coverage"
    ]
  },
  "template": true
}
