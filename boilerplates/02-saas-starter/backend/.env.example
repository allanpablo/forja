# Copie para .env (nesta pasta) e preencha. Sem JWT_SECRET/JWT_REFRESH_SECRET/DATABASE_URL a API não sobe.
NODE_ENV=development
PORT=3000

# PostgreSQL (docker compose up -d db)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/saas_starter

# Segredos distintos, longos e aleatórios (ex.: openssl rand -base64 48)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Moeda das faturas (ISO 4217)
BILLING_CURRENCY=BRL
